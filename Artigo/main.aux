\@writefile{toc}{\contentsline {paragraph}{A transfer failure traced to a simulator artifact.}{18}{section*.38}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Removing the artifact restores transfer in both directions.}{19}{section*.39}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{A common physical scale is not enough by itself.}{19}{section*.40}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Diagnosing the transfer failure (first round, three training seeds $\times $ 30 outbreaks). Left: the original simulator, with non-arboviral suspects anywhere on the grid; the Recife-trained agent fails even in its own held-out years and collapses in Rio. Right: corrected, and with both cities at 200\,m per cell in their real extent; the smaller city becomes denser because each episode has the same number of cases, and the Rio-trained agent fails there. Paired differences with the clinician-guided rule, 95\% intervals; bold marks intervals that exclude zero. Compare with the corrected environment in Figure~\ref {fig:transfer}.}}{19}{figure.10}\protected@file@percent }
\newlabel{fig:transfer_corrected}{{10}{19}{Diagnosing the transfer failure (first round, three training seeds $\times $ 30 outbreaks). Left: the original simulator, with non-arboviral suspects anywhere on the grid; the Recife-trained agent fails even in its own held-out years and collapses in Rio. Right: corrected, and with both cities at 200\,m per cell in their real extent; the smaller city becomes denser because each episode has the same number of cases, and the Rio-trained agent fails there. Paired differences with the clinician-guided rule, 95\% intervals; bold marks intervals that exclude zero. Compare with the corrected environment in Figure~\ref {fig:transfer}}{figure.10}{}}
